# =============================================================================
# GenoMAS API Configuration
# =============================================================================
# Instructions:
# 1. Copy this file to .env: cp env.example .env
# 2. Uncomment the lines for providers you want to use (remove the # symbol)
# 3. Replace the placeholder values with your actual API keys
# 4. For load balancing, you can add multiple API keys with suffixes _2, _3, ...
#
# Note: You only need to configure the provider(s) you plan to use.
# =============================================================================


# -----------------------------------------------------------------------------
# OpenAI Configuration
# Required for: GPT-4o, GPT-5, o1, o3, o4 models
# Get your API key from: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
# OPENAI_API_KEY_1=your_openai_api_key_here
# OPENAI_ORGANIZATION_1=your_openai_org_id_here

# Additional OpenAI keys for load balancing (optional)
# OPENAI_API_KEY_2=your_second_openai_api_key_here
# OPENAI_ORGANIZATION_2=your_second_openai_org_id_here
# OPENAI_API_KEY_3=your_third_openai_api_key_here
# OPENAI_ORGANIZATION_3=your_third_openai_org_id_here


# -----------------------------------------------------------------------------
# Anthropic Configuration
# Required for: Claude 3.5, Claude 4, Claude Sonnet 4.5 models
# Get your API key from: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY_1=your_anthropic_api_key_here

# Additional Anthropic keys for load balancing (optional)
# ANTHROPIC_API_KEY_2=your_second_anthropic_api_key_here
# ANTHROPIC_API_KEY_3=your_third_anthropic_api_key_here


# -----------------------------------------------------------------------------
# Google Configuration
# Required for: Gemini 1.5, Gemini 2.0, Gemini 2.5 models
# Get your API key from: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
# GOOGLE_API_KEY_1=your_google_api_key_here

# Additional Google keys for load balancing (optional)
# GOOGLE_API_KEY_2=your_second_google_api_key_here
# GOOGLE_API_KEY_3=your_third_google_api_key_here


# -----------------------------------------------------------------------------
# Novita AI Configuration
# Required for: Open-source models via API (DeepSeek-R1, Llama, Qwen)
# Get your API key from: https://novita.ai/
# Recommended for: Better latency than official DeepSeek API
# -----------------------------------------------------------------------------
# NOVITA_API_KEY_1=your_novita_api_key_here

# Additional Novita keys for load balancing (optional)
# NOVITA_API_KEY_2=your_second_novita_api_key_here
# NOVITA_API_KEY_3=your_third_novita_api_key_here


# -----------------------------------------------------------------------------
# DeepSeek Configuration (Official API)
# Required for: DeepSeek-V3, DeepSeek-R1 via official API
# Get your API key from: https://platform.deepseek.com/api_keys
# Warning: Official DeepSeek API can be slow. Consider using Novita instead.
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY_1=your_deepseek_api_key_here

# Additional DeepSeek keys for load balancing (optional)
# DEEPSEEK_API_KEY_2=your_second_deepseek_api_key_here
# DEEPSEEK_API_KEY_3=your_third_deepseek_api_key_here

